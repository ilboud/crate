# Copy to .env and fill in. .env is gitignored; .env.example is not.

# ---- Required ----------------------------------------------------------
# https://www.discogs.com/settings/developers  → Generate new token
# This token can MODIFY your collection. Keep it off the internet.
DISCOGS_PERSONAL_ACCESS_TOKEN=

# ---- Optional ----------------------------------------------------------
# Skipped if blank — the app asks Discogs who the token belongs to.
DISCOGS_USERNAME=

# Host port for the web app. DSM itself uses 5000/5001.
APP_PORT=8088

# ---- Chat (optional) ---------------------------------------------------
# Leave both keys blank to run without chat; browsing and search still work.
#
# Anything set here OVERRIDES the Settings screen and greys the control out, so
# leave a line blank unless you specifically want it pinned. CHAT_BACKEND picks
# the provider (anthropic | openai); blank lets you switch it in the app.
CHAT_BACKEND=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Only needed when the key covers ALL workspaces — such a key is identity-linked
# and the API rejects it without an id saying which workspace the request acts
# in. A key scoped to one workspace needs nothing here. Console → Settings →
# Workspaces, the ID column.
ANTHROPIC_WORKSPACE_ID=
OPENAI_API_KEY=
OPENAI_MODEL=
