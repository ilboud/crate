# Copy to .env and fill in. .env is gitignored; .env.example is not.

# ---- Required ----------------------------------------------------------
# https://www.discogs.com/settings/developers  → Generate new token
# This token can MODIFY your collection. Keep it off the internet.
DISCOGS_PERSONAL_ACCESS_TOKEN=

# ---- Optional ----------------------------------------------------------
# Skipped if blank — the app asks Discogs who the token belongs to.
DISCOGS_USERNAME=

# Host port for the web app. DSM itself uses 5000/5001.
APP_PORT=8088

# ---- Chat (optional) ---------------------------------------------------
# Leave both keys blank to run without chat; browsing and search still work.
# CHAT_BACKEND selects which one is used: anthropic | openai
CHAT_BACKEND=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
